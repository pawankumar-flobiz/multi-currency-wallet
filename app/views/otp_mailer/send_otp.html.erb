<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
    <style>
      .otp-code {
        font-size: 32px;
        font-weight: bold;
        letter-spacing: 5px;
        color: #2d3436;
        background: #f1f2f6;
        padding: 15px;
        text-align: center;
        border-radius: 8px;
        display: inline-block;
        margin: 20px 0;
      }
      .footer {
        font-size: 12px;
        color: #636e72;
        margin-top: 30px;
      }
    </style>
  </head>
  <body>
    <h2>Hello, <%= @user.name %>!</h2>
    <p>You requested a verification code to access your account.</p>
    
    <div class="otp-code">
      <%= @otp %>
    </div>

    <p>This code will expire in <strong><%= @expiry %> minutes</strong>.</p>
    <p>If you did not request this, please ignore this email or contact support.</p>
    
    <hr />
    <div class="footer">
      <p>Sent by Currency Wallet.</p>
    </div>
  </body>
</html>